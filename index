<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Truck Departure Form</title>
<style>
  :root { --bg:#f3f4f6; --card:#fff; --text:#111827; --muted:#6b7280; --accent:#d97706; --border:#d1d5db; }
  * { box-sizing:border-box; }
  body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center;
         background:var(--bg); color:var(--text); font-family:system-ui,Arial,sans-serif; padding:16px; }
  .card { background:var(--card); width:100%; max-width:420px; padding:24px; border-radius:12px;
          box-shadow:0 4px 16px rgba(0,0,0,.1); }
  h1 { margin:0 0 4px; font-size:22px; }
  p.sub { margin:0 0 20px; color:var(--muted); font-size:14px; }
  label { display:block; margin:14px 0 6px; font-weight:600; font-size:14px; }
  input { width:100%; padding:12px; font-size:16px; border:1px solid var(--border); border-radius:8px; }
  input:focus { outline:2px solid var(--accent); border-color:var(--accent); }
  button { margin-top:22px; width:100%; padding:14px; font-size:16px; font-weight:700; color:#fff;
           background:var(--accent); border:0; border-radius:8px; cursor:pointer; }
  button:disabled { opacity:.6; cursor:wait; }
  #msg { margin-top:14px; text-align:center; font-size:14px; min-height:20px; }
  .ok { color:#15803d; } .err { color:#b91c1c; }
</style>
</head>
<body>
<div class="card">
  <h1>🚚 Truck Departure</h1>
  <p class="sub">Fill in the details and submit. It goes straight to the Google Sheet.</p>

  <form id="f" autocomplete="off">
    <label for="truck">Trucking Name</label>
    <input id="truck" name="truckingName" required>

    <label for="date">Date of Departure</label>
    <input id="date" name="departureDate" type="date" required>

    <label for="plate">Plate Number</label>
    <input id="plate" name="plateNumber" required style="text-transform:uppercase" placeholder="e.g. CCR 8351">

    <label for="contact">Contact Number</label>
    <input id="contact" name="contactNumber" type="tel" required placeholder="e.g. 09218010894">

    <button id="btn" type="submit">Submit</button>
    <div id="msg"></div>
  </form>
</div>

<script>
  // PASTE YOUR GOOGLE APPS SCRIPT WEB APP URL HERE (ends with /exec)
  const SCRIPT_URL = "PASTE_YOUR_WEB_APP_URL_HERE";

  const form = document.getElementById("f");
  const btn = document.getElementById("btn");
  const msg = document.getElementById("msg");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (SCRIPT_URL.startsWith("PASTE")) {
      msg.className = "err";
      msg.textContent = "Setup not finished: add the Web App URL in index.html.";
      return;
    }
    btn.disabled = true;
    msg.className = "";
    msg.textContent = "Sending...";
    try {
      await fetch(SCRIPT_URL, {
        method: "POST",
        mode: "no-cors", // Apps Script does not send CORS headers; the data still arrives
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(new FormData(form)).toString()
      });
      msg.className = "ok";
      msg.textContent = "✅ Submitted! Saved to Google Sheet.";
      form.reset();
    } catch (err) {
      msg.className = "err";
      msg.textContent = "❌ Failed to send. Check your internet and try again.";
    }
    btn.disabled = false;
  });
</script>
</body>
</html>
